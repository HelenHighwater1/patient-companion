# FastAPI backend for Patient Companion.
#   docker build -f deploy/Dockerfile.api -t patient-companion-api .
#   docker run -p 8000:8000 --env-file .env patient-companion-api
FROM python:3.12-slim

WORKDIR /app

COPY backend/pyproject.toml backend/
COPY backend/src backend/src
COPY backend/tests backend/tests
COPY knowledge knowledge/

RUN pip install --no-cache-dir './backend'

EXPOSE 8000

# Ingest the corpus at startup (uses existing store if ingest can't run),
# then serve. Store is read-only at runtime.
CMD ["sh", "-c", "python -m patient_companion.rag.ingest || echo 'ingest skipped'; exec uvicorn patient_companion.server.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
