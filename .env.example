# Copy to .env and fill in your keys.
# Anthropic powers every LLM call (rewrite, intake, answer, guard, tone, prep).
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI is used only for embeddings (text-embedding-3-small).
OPENAI_API_KEY=your-openai-key

# Optional overrides (see backend/src/patient_companion/config.py for all settings)
# PC_LLM_PROVIDER=anthropic        # anthropic | mock
# PC_EMBED_PROVIDER=openai         # openai | mock
# PC_RERANKER_BACKEND=none         # none | fastembed (pip install '.[rerank]')
# PC_RATE_LIMIT_PER_HOUR=60
